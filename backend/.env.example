PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/chatters
JWT_SECRET=change_this_access_secret
RESET_JWT_SECRET=change_this_reset_secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=15m
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Chatters <your-email@gmail.com>"

# Cloudinary — used for message image AND video attachments. Keep these
# server-side only; CLOUDINARY_API_SECRET must never be exposed to the
# frontend (it's read once in config/cloudinary.js and only ever touched
# again inside cloudinaryService.generateUploadSignature).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional overrides for message image upload limits (see src/config/upload.js)
MAX_IMAGES_PER_MESSAGE=5
MAX_IMAGE_SIZE_MB=10

# Optional overrides for message video upload limits (see src/config/upload.js).
# Videos upload directly from the browser to Cloudinary (never through this
# server), so MAX_VIDEO_SIZE_MB is enforced by re-checking the *verified*
# Cloudinary asset after upload, not by a request body size limit here.
MAX_VIDEOS_PER_MESSAGE=2
MAX_VIDEO_SIZE_MB=100
# How long a signed video-upload authorization stays valid (minutes) before
# it self-expires via MongoDB TTL and can no longer be used or redeemed.
PENDING_VIDEO_UPLOAD_TTL_MINUTES=15
