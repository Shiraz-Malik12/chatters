PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/chatters
JWT_SECRET=change_this_access_secret
RESET_JWT_SECRET=change_this_reset_secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=15m
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Chatters <your-email@gmail.com>"

# Cloudinary — used for message image attachments. Keep these server-side only;
# CLOUDINARY_API_SECRET must never be exposed to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional overrides for message image upload limits (see src/config/upload.js)
MAX_IMAGES_PER_MESSAGE=5
MAX_IMAGE_SIZE_MB=10
